// api.nova — Todo backend: Nova Boot REST API + static frontend.
//
// Run from the nova-lang directory:
//   ./nova dom showcase/todo/ui.nova -o showcase/todo/public/app.html
//   NOVA_PORT=8082 ./nova run showcase/todo/api.nova
//
// Then open http://localhost:8082/ in a browser, and:
//   curl localhost:8082/api/todos

import std.web

data class Todo(id: Int, text: String, done: Bool)

var todos: List[Todo] = []
var nextId: Int = 1

fn findTodo(id: Int) -> Option[Todo] {
  for t in todos {
    if t.id == id {
      return Some(t)
    }
  }
  return None
}

// GET /api/todos -> [Todo]
effect fn listTodos(req: Request) -> Result[Response, Response] {
  return Ok(jsonResponse(200, todos))
}

// POST /api/todos {"text": _} -> 201 Todo
effect fn createTodo(req: Request) -> Result[Response, Response] {
  let body = web.needJson(req)?
  let text = match jsonGet(body, "text") {
    Some(v) => match jsonStr(v) {
      Some(t) => Ok(t),
      None => Err(web.jsonErr(400, "field 'text' must be a string"))
    },
    None => Err(web.jsonErr(400, "missing field 'text'"))
  }?
  let todo = Todo(id: nextId, text: text, done: false)
  nextId = nextId + 1
  todos.push(todo)
  return Ok(jsonResponse(201, todo))
}

// PUT /api/todos/{id: Int} {"done": _} -> Todo
effect fn updateTodo(req: Request) -> Result[Response, Response] {
  let id = match paramInt(req, "id") {
    Some(i) => Ok(i),
    None => Err(web.jsonErr(400, "missing id"))
  }?
  let cur = match findTodo(id) {
    Some(t) => Ok(t),
    None => Err(web.jsonErr(404, "no todo " + str(id)))
  }?
  let body = web.needJson(req)?
  let done = match jsonGet(body, "done") {
    Some(v) => match jsonBool(v) {
      Some(b) => b,
      None => cur.done
    },
    None => cur.done
  }
  let updated = Todo(id: id, text: cur.text, done: done)
  let rebuilt: List[Todo] = []
  for t in todos {
    if t.id == id {
      rebuilt.push(updated)
    } else {
      rebuilt.push(t)
    }
  }
  todos = rebuilt
  return Ok(jsonResponse(200, updated))
}

// DELETE /api/todos/{id: Int} -> 200
effect fn deleteTodo(req: Request) -> Result[Response, Response] {
  let id = match paramInt(req, "id") {
    Some(i) => Ok(i),
    None => Err(web.jsonErr(400, "missing id"))
  }?
  let kept: List[Todo] = []
  var found = false
  for t in todos {
    if t.id == id {
      found = true
    } else {
      kept.push(t)
    }
  }
  if not found {
    return Err(web.jsonErr(404, "no todo " + str(id)))
  }
  todos = kept
  return Ok(web.ok("deleted"))
}

effect io fn boot(cap: IO) {
  let r = router()
  // The API...
  get(r, "/api/todos", listTodos, cap)
  post(r, "/api/todos", createTodo, cap)
  put(r, "/api/todos/{id: Int}", updateTodo, cap)
  delete(r, "/api/todos/{id: Int}", deleteTodo, cap)
  // ...and the frontend bundle, compiled by `nova dom` (see README).
  staticDir(r, "/", "showcase/todo/public")

  let port = match env("NOVA_PORT") {
    Some(p) => match parseInt(p) {
      Some(n) => n,
      None => 8082
    },
    None => 8082
  }
  match serve(r, port, cap) {
    Ok(_) => print("stopped"),
    Err(e) => print("serve failed: " + e)
  }
}

boot(io)
