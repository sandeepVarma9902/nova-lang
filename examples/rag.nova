// rag.nova — RAG-native Nova: Vector[N], ai embed, similarity, topK.
//
// Vectors are first-class types: Vector[1536] is checked at compile time,
// and mixing dimensions is a type error. `ai embed` is a mock provider
// with the real interface (swap the provider for a real one later);
// similarity/topK are exact stdlib math.
//
// Run: ./nova run examples/rag.nova

// A tiny knowledge base.
let docs: List[String] = [
  "Nova is a programming language designed for AI agents",
  "The NovaVM executes bytecode compiled from Nova source",
  "Streams move events between Nova services",
  "Python is a popular programming language"
]

// Embed every document. In production this is one `ai` call per chunk,
// stored next to the text; here the mock embeds deterministically.
effect fn embedAll(cap: Net) -> List[Vector[8]] {
  let vecs: List[Vector[8]] = []
  for d in docs {
    vecs.push(ai embed(d, cap))
  }
  return vecs
}

effect fn main(cap: Net) {
  let vecs = embedAll(cap)
  let q = ai embed("how do Nova programs run?", cap)

  // Rank documents by cosine similarity, take the top 2.
  let top = topK(q, vecs, 2)
  print("query: how do Nova programs run?")
  for i in top {
    let s = similarity(q, vecs[i])
    print("[" + str(i) + "] sim=" + str(s) + " :: " + docs[i])
  }

  // Dimension mismatches are compile-time errors:
  //   let bad: Vector[4] = ai embed("x", cap)   // E_TYPE_MISMATCH
  //   similarity(q, bad)                        // E_TYPE_MISMATCH
}

main(net)

// EXPECT:
// query: how do Nova programs run?
// [1] sim=0.35 :: The NovaVM executes bytecode compiled from Nova source
// [0] sim=-0.12 :: Nova is a programming language designed for AI agents
