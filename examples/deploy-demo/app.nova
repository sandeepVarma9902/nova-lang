// app.nova — the optional-but-built-in application manifest.
// Convention over configuration: app name, threading model, declared
// resources, environments, docker settings, deploy target.

app "deploy-demo" {
  version = "0.1.0"
  entry = "main.nova"
  threading = "single"   // single | multi | auto — deterministic here

  env dev {
    log_level = "debug"
  }
  env prod {
    log_level = "info"
  }

  resource stream "events" { partitions = 4 }
  resource secret "db-password" { store = "env" }
  resource cron "nightly-report" { schedule = "0 2 * * *", run = "report.nova" }

  docker {
    base = "python:3.12-slim"
    port = 8080
  }

  deploy target = "local"   // local | docker
}
