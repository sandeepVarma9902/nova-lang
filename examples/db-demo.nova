// db-demo.nova — database nativity: pulled models + typed queries.
//
// The models in blog_models.nova were generated by:
//   ./nova db pull --dsn sqlite:///examples/blog.db \
//     --out examples/blog_models.nova
// That also wrote examples/.nova-schema.json, which `nova check` uses to
// validate table/column names at compile time (best effort):
//   dbTable(db, "postz")                          // E_DB_SCHEMA
//   dbTable(db, "posts").where("titl", "=", "x")  // E_DB_SCHEMA
//
// Run: ./nova run examples/db-demo.nova   (from the nova-lang directory)

import blog_models

// Queries return Results; `?` threads the errors out. Rows are Json;
// the pulled postFromJson/userFromJson map them onto model types.
effect io fn runDemo(cap: IO) -> Result[String, String] {
  let db = dbOpen("sqlite:///examples/blog.db", cap)?

  // Typed query builder: select/where/orderBy/limit compose; all() runs.
  let q = dbTable(db, "posts").select(["id", "title", "views"])
  let q2 = q.where("views", ">", 50).orderBy("views", "desc")
  let rows = q2.all()?
  print("popular posts:")
  for row in rows {
    match blog_models.postFromJson(row) {
      Ok(p) => print("  #" + str(p.id) + " " + p.title
                     + " (" + str(p.views) + " views)"),
      Err(e) => print("  bad row: " + e)
    }
  }

  // first() is Option[Json]: Some or None, never null.
  let one = dbTable(db, "users").where("id", "=", 2).first()?
  match one {
    Some(j) => match blog_models.userFromJson(j) {
      Ok(u) => print("user 2: " + u.name),
      Err(e) => print("bad user: " + e)
    },
    None => print("user 2 not found")
  }
  return Ok("demo complete")
}

match runDemo(io) {
  Ok(msg) => print(msg),
  Err(e) => print("demo failed: " + e)
}

// EXPECT:
// popular posts:
//   #1 Hello Nova (150 views)
//   #2 Boot (89 views)
// user 2: Grace
// demo complete
